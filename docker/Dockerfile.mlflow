# MLflow tracking server (backend : Postgres, artifacts : MinIO/S3)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir "mlflow>=2.11" "psycopg2-binary" "boto3" "cloudpickle" "pillow" "numpy" "pandas" "scikit-learn" "xgboost"

EXPOSE 5000

# Forme shell (pas JSON-exec) : requise pour que $BACKEND_STORE_URI / $ARTIFACT_ROOT
# soient réellement substitués par les variables d'environnement du conteneur — la
# forme exec ne passe par aucun shell et ne les interpole jamais.
#
# --default-artifact-root utilise le schéma proxy `mlflow-artifacts:/` (pas l'URI S3
# littérale) : avec --serve-artifacts, TOUT client (y compris cif-train exécuté hors
# conteneur, sans identifiants MinIO) route ses artefacts via l'API HTTP du serveur —
# --artifacts-destination indique au SERVEUR seul où se trouve le stockage réel. Sans
# ça, mlflow.sklearn.log_model() tente un accès S3 direct depuis le client et échoue
# (NoCredentialsError) dès qu'il n'a pas les credentials MinIO dans son environnement.
# --allowed-hosts : MLflow 3.x rejette par défaut (403, protection anti DNS-rebinding)
# tout Host header hors "localhost"/IP privées — le nom de service Docker "mlflow" (tel
# que résolu par MLFLOW_TRACKING_URI=http://mlflow:5000 côté API/Dagster/CI) n'est ni
# l'un ni l'autre et se faisait bloquer. Réseau interne isolé (voir en-tête du compose) :
# élargir aux clients internes est sans risque, pas une exposition publique.
# Vérifié dans mlflow/server/security_utils.py : is_allowed_host_header() fait un match
# EXACT sauf si le motif contient "*" (fnmatch) — et le Host header inclut le port
# ("localhost:5000"). Le défaut de MLflow lui-même génère "localhost:*" pour ça ; on
# reproduit le même motif pour "mlflow" (confirmé : sans wildcard, "localhost" seul
# rejette "localhost:5000" avec un 403, le défaut le tolérait via son propre "localhost:*").
CMD mlflow server \
    --host 0.0.0.0 \
    --port 5000 \
    --backend-store-uri "$BACKEND_STORE_URI" \
    --default-artifact-root mlflow-artifacts:/ \
    --artifacts-destination "$ARTIFACT_ROOT" \
    --serve-artifacts \
    --allowed-hosts "mlflow,mlflow:*,localhost,localhost:*"