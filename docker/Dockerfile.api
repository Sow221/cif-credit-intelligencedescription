# API de scoring CIF Credit Intelligence
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md requirements-serving.lock.txt ./
COPY src ./src

# Versions exactes verrouillées, pas une résolution libre à chaque build (voir deploy/huggingface/Dockerfile).
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir -r requirements-serving.lock.txt && \
    python -m pip install --no-cache-dir --no-deps .

# --- Runtime minimale, utilisateur non-privilégié ---
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MLFLOW_TRACKING_URI=http://mlflow:5000 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN groupadd -r cif && useradd -r -g cif cif && chown -R cif:cif /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/src ./src

# Pas de réinstallation ici : le stage builder a déjà installé le package (avec ses
# entry points dans /usr/local/bin) et ses dépendances (site-packages) — les deux sont
# copiés ci-dessus. Un second `pip install .` échouerait de toute façon : pyproject.toml
# n'est jamais copié dans ce stage.
USER cif

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]