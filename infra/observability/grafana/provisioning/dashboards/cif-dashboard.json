{
  "title": "CIF Credit Intelligence — Monitoring",
  "uid": "cif-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Drift ratio (features en dérive)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "cif_drift_ratio", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Débit requêtes HTTP/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(cif_http_requests_total[1m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Latence p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cif_http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Distribution probabilité de défaut",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "rate(cif_score_probability_bucket[5m])", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Alertes de drift cumulées",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "expr": "cif_drift_alerts_total", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Scoring requests/s",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "sum(rate(cif_score_requests_total[1m]))", "refId": "A" }]
    }
  ]
}
