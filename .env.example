# Variables d'environnement de la plateforme CIF Credit Intelligence
# Copier vers .env et adapter — AUCUN secret ne doit être commité.

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Postgres (backend MLflow) ---
PG_USER=mlflow
PG_PASSWORD=change-me
PG_DB=mlflow

# --- MinIO (artifact store) ---
MINIO_ROOT_USER=mlflow
MINIO_ROOT_PASSWORD=change-me-too

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-three

# --- API (JWT + rate limit) — Semaine 2 ---
CIF_API_CLIENT_ID=cif-agent
CIF_API_CLIENT_SECRET=change-me-four
CIF_JWT_SECRET=change-me-five
CIF_API__REQUEST_LIMITS_RATE_PER_MINUTE=120

# --- PostgreSQL audit (Semaine 3) ---
CIF_DATABASE__URL=postgresql+psycopg2://mlflow:mlflow@localhost:5432/mlflow